# ── hypr: machine state, wallpaper copies, generated colours ──
hypr/.config/hypr/.initial_startup_done
hypr/.config/hypr/wallpaper_effects/.wallpaper_*
hypr/.config/hypr/wallust/wallust-hyprland.conf
hypr/.config/hypr/wallust/wallust-hyprland.lua
# ── quickshell: colours generated by wallust ──
quickshell/.config/quickshell/qml_color.json
# ── theme: personal bookmarks, machine-specific links into ~/.themes ──
theme/.config/gtk-3.0/bookmarks
theme/.config/gtk-4.0/assets
theme/.config/gtk-4.0/gtk.css
theme/.config/gtk-4.0/gtk-dark.css
# ── graft: session cache written by the graft MCP server ──
/graft/
# ── swaync: colours generated by wallust ──
swaync/.config/swaync/wallust/
